# Dependencies and Package Stores
node_modules/
vendor/
.pnpm-store/
bower_components/

# Build and Compilation Artifacts
dist/
build/
out/
target/
bin/
obj/
*.min.js
*.bundle.js
*.map
*.wasm

# Python & Runtime Environments
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/
.pytest_cache/
.mypy_cache/

# Testing and Coverage Reports
coverage/
.nyc_output/
test-results/
playwright-report/
cypress/videos/
cypress/screenshots/

# Temporary and Cache Directories
.cache/
.turbo/
.parcel-cache/
tmp/
temp/
*.tmp

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment and Secrets (Never commit secrets)
.env
.env.local
.env.*.local
*.pem
*.key
*.cert
credentials.json

# Scratch and Temporary Agent Outputs
.agents/scratch/
.agents/*.tmp.md

# Codsblu Runtime Artifacts (generated at runtime; never commit)
.agents/.codsblu.pid
.agents/.pending-changes.json
.agents/.cache_scan.json
